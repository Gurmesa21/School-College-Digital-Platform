datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum InstitutionType {
  KINDERGARTEN
  PRIMARY_SECONDARY
  COLLEGE
  TVET_TRAINING_CENTRE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SectionType {
  HERO
  TEXT_CONTENT
  IMAGE_MEDIA
  FEATURE_GRID
  ACCORDION
  CTA_BANNER
  STATS_COUNTER
  TESTIMONIALS
}

enum NavigationLocation {
  HEADER
  FOOTER
  QUICK_LINKS
}

enum MediaCategory {
  IMAGE
  DOCUMENT
  VIDEO
  LOGO
  BANNER
}

enum CategoryType {
  MEDIA
  PAGE
  GENERAL
}

enum FormType {
  GENERAL_ENQUIRY
  ADMISSIONS_INQUIRY
  CONTACT_US
  APPLICATION
  FEEDBACK
  OTHER
}

enum FormFieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  NUMBER
  SELECT
  RADIO
  CHECKBOX
  DATE
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  ARCHIVED
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum AnnouncementAudience {
  GENERAL
  STUDENTS
  PARENTS
  STAFF
}

model Tenant {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  institutionType InstitutionType @default(PRIMARY_SECONDARY)
  status          TenantStatus    @default(ACTIVE)
  timezone        String          @default("UTC")
  defaultLocale   String          @default("en")
  contactEmail    String?
  contactPhone    String?
  address         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  domains         TenantDomain[]
  memberships     Membership[]
  roles           Role[]
  invitations     TenantInvitation[]
  auditLogs       AuditLog[]
  pages           Page[]
  navigationMenus NavigationMenu[]
  mediaAssets     MediaAsset[]
  categories      Category[]
  forms           Form[]
  formSubmissions FormSubmission[]
  reusableSections ReusableSection[]
  academicLevels   AcademicLevel[]
  academicDepartments AcademicDepartment[]
  programmes       Programme[]
  courses          Course[]
  staffProfiles    StaffProfile[]
  newsArticles     NewsArticle[]
  announcements    Announcement[]
  events           EventItem[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model TenantDomain {
  id         String   @id @default(cuid())
  hostname   String   @unique
  isPrimary  Boolean  @default(false)
  isVerified Boolean  @default(true)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([hostname])
  @@index([isVerified])
  @@map("tenant_domains")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  status                  UserStatus               @default(ACTIVE)
  firstName               String?
  lastName                String?
  emailVerifiedAt         DateTime?
  isSuperAdmin            Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  memberships             Membership[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sentInvitations         TenantInvitation[]       @relation("SentInvitations")
  auditLogs               AuditLog[]               @relation("ActorAuditLogs")
  authoredPages           Page[]                   @relation("PageAuthor")
  editedPages             Page[]                   @relation("PageEditor")
  uploadedMedia           MediaAsset[]             @relation("UploadedMedia")
  reviewedSubmissions     FormSubmission[]         @relation("ReviewedSubmissions")
  authoredReusableSections ReusableSection[]        @relation("ReusableSectionAuthor")
  editedReusableSections   ReusableSection[]        @relation("ReusableSectionEditor")
  authoredProgrammes       Programme[]              @relation("ProgrammeAuthor")
  editedProgrammes         Programme[]              @relation("ProgrammeEditor")
  staffProfiles           StaffProfile[]           @relation("StaffUserAccount")
  authoredStaff           StaffProfile[]           @relation("StaffAuthor")
  editedStaff             StaffProfile[]           @relation("StaffEditor")
  authoredNews            NewsArticle[]            @relation("NewsAuthor")
  editedNews              NewsArticle[]            @relation("NewsEditor")
  authoredAnnouncements   Announcement[]           @relation("AnnouncementAuthor")
  editedAnnouncements     Announcement[]           @relation("AnnouncementEditor")
  authoredEvents          EventItem[]              @relation("EventAuthor")
  editedEvents            EventItem[]              @relation("EventEditor")

  @@index([email])
  @@index([status])
  @@map("users")
}

model Membership {
  id         String           @id @default(cuid())
  userId     String
  tenantId   String
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles      MembershipRole[]

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@map("memberships")
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String?
  name        String
  displayName String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@index([tenantId])
  @@index([name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  category    String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles       RolePermission[]

  @@index([code])
  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String
  roleId       String
  assignedAt   DateTime   @default(now())

  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
  @@map("membership_roles")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model TenantInvitation {
  id            String           @id @default(cuid())
  tenantId      String
  email         String
  inviterUserId String
  roleIds       String[]
  tokenHash     String           @unique
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  sentAt        DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter       User             @relation("SentInvitations", fields: [inviterUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([tenantId, status])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("tenant_invitations")
}

model AuditLog {
  id         String       @id @default(cuid())
  tenantId   String?
  actorId    String?
  actorEmail String?
  actorType  String       @default("USER")
  action     String
  entityType String
  entityId   String?
  outcome    AuditOutcome @default(SUCCESS)
  requestId  String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  tenant     Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor      User?        @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Page {
  id                 String        @id @default(cuid())
  tenantId           String
  title              String
  slug               String
  summary            String?
  status             PageStatus    @default(DRAFT)
  authorId           String?
  lastEditorId       String?
  publishedAt        DateTime?
  scheduledPublishAt DateTime?
  archivedAt         DateTime?
  expiresAt          DateTime?
  seoTitle           String?
  seoDescription     String?
  canonicalUrl       String?
  version            Int           @default(1)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author             User?         @relation("PageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lastEditor         User?         @relation("PageEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)
  sections           PageSection[]
  navigationItems    NavigationMenuItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([status, publishedAt])
  @@index([scheduledPublishAt])
  @@map("pages")
}

model PageSection {
  id                String           @id @default(cuid())
  pageId            String
  sectionType       SectionType
  sortOrder         Int              @default(0)
  isVisible         Boolean          @default(true)
  config            Json
  reusableSectionId String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  page              Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  reusableSection   ReusableSection? @relation(fields: [reusableSectionId], references: [id], onDelete: SetNull)

  @@index([pageId, sortOrder])
  @@index([reusableSectionId])
  @@map("page_sections")
}

model ReusableSection {
  id           String        @id @default(cuid())
  tenantId     String
  name         String
  slug         String
  description  String?
  sectionType  SectionType
  category     String?
  config       Json
  isGlobal     Boolean       @default(false)
  authorId     String?
  lastEditorId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author       User?         @relation("ReusableSectionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lastEditor   User?         @relation("ReusableSectionEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)
  placements   PageSection[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([sectionType])
  @@map("reusable_sections")
}

model NavigationMenu {
  id          String              @id @default(cuid())
  tenantId    String
  location    NavigationLocation  @default(HEADER)
  title       String
  isPublished Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items       NavigationMenuItem[]

  @@unique([tenantId, location])
  @@index([tenantId])
  @@map("navigation_menus")
}

model NavigationMenuItem {
  id          String              @id @default(cuid())
  menuId      String
  parentId    String?
  label       String
  url         String
  target      String              @default("_self")
  order       Int                 @default(0)
  isVisible   Boolean             @default(true)
  pageId      String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  menu        NavigationMenu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent      NavigationMenuItem? @relation("MenuItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    NavigationMenuItem[] @relation("MenuItemHierarchy")
  page        Page?               @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([menuId, order])
  @@index([parentId])
  @@index([pageId])
  @@map("navigation_menu_items")
}

model Category {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  type        CategoryType  @default(GENERAL)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mediaAssets MediaAsset[]

  @@unique([tenantId, slug])
  @@index([tenantId, type])
  @@map("categories")
}

model MediaAsset {
  id            String        @id @default(cuid())
  tenantId      String
  uploaderId    String?
  title         String
  altText       String?
  caption       String?
  category      MediaCategory @default(IMAGE)
  mimeType      String
  fileSizeBytes Int
  storageKey    String
  publicUrl     String
  isPublic      Boolean       @default(true)
  isDecorative  Boolean       @default(false)
  storagePolicy String        @default("PUBLIC")
  storageProvider String      @default("local")
  categoryId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader      User?         @relation("UploadedMedia", fields: [uploaderId], references: [id], onDelete: SetNull)
  taxCategory   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  programmes    Programme[]
  staffProfiles StaffProfile[]
  newsArticles  NewsArticle[]
  events        EventItem[]

  @@index([tenantId, category])
  @@index([tenantId, isPublic])
  @@index([tenantId, storagePolicy])
  @@index([uploaderId])
  @@map("media_assets")
}

model Form {
  id               String           @id @default(cuid())
  tenantId         String
  title            String
  slug             String
  description      String?
  type             FormType         @default(GENERAL_ENQUIRY)
  recipientEmails  String[]         @default([])
  isPublished      Boolean          @default(true)
  successMessage   String?
  submitButtonText String           @default("Submit")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fields           FormField[]
  submissions      FormSubmission[]

  @@unique([tenantId, slug])
  @@index([tenantId, isPublished])
  @@map("forms")
}

model FormField {
  id              String        @id @default(cuid())
  formId          String
  name            String
  label           String
  fieldType       FormFieldType @default(TEXT)
  placeholder     String?
  helpText        String?
  defaultValue    String?
  isRequired      Boolean       @default(false)
  validationRules Json?
  options         Json?
  orderIndex      Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  form            Form          @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, orderIndex])
  @@map("form_fields")
}

model FormSubmission {
  id             String           @id @default(cuid())
  tenantId       String
  formId         String
  data           Json
  status         SubmissionStatus @default(PENDING)
  submitterEmail String?
  submitterName  String?
  submitterPhone String?
  ipAddressHash  String?
  userAgent      String?
  adminNotes     String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  form           Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  reviewedBy     User?            @relation("ReviewedSubmissions", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([formId, createdAt])
  @@index([reviewedById])
  @@map("form_submissions")
}

model AcademicLevel {
  id          String      @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  levelType   String?
  description String?
  orderIndex  Int         @default(0)
  minAge      Int?
  maxAge      Int?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programmes  Programme[]
  courses     Course[]

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("academic_levels")
}

model AcademicDepartment {
  id          String               @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  code        String?
  description String?
  parentId    String?
  orderIndex  Int                  @default(0)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      AcademicDepartment?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    AcademicDepartment[] @relation("DepartmentHierarchy")
  programmes  Programme[]
  courses     Course[]
  staffProfiles StaffProfile[]

  @@unique([tenantId, slug])
  @@index([tenantId, parentId])
  @@map("academic_departments")
}

model Programme {
  id                    String              @id @default(cuid())
  tenantId              String
  title                 String
  slug                  String
  summary               String?
  description           String?
  programmeType         String?
  levelId               String?
  departmentId          String?
  duration              String?
  entryRequirements     String?
  qualificationsAwarded String?
  curriculum            String?
  tuitionFee            Float?
  tuitionCurrency       String?             @default("USD")
  tuitionPeriod         String?
  tuitionDescription    String?
  displayTuition        Boolean             @default(false)
  heroMediaId           String?
  status                PageStatus          @default(DRAFT)
  isActive              Boolean             @default(true)
  isFeatured            Boolean             @default(false)
  orderIndex            Int                 @default(0)
  publishedAt           DateTime?
  archivedAt            DateTime?
  seoTitle              String?
  seoDescription        String?
  canonicalUrl          String?
  authorId              String?
  lastEditorId          String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  level                 AcademicLevel?      @relation(fields: [levelId], references: [id], onDelete: SetNull)
  department            AcademicDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  heroMedia             MediaAsset?         @relation(fields: [heroMediaId], references: [id], onDelete: SetNull)
  author                User?               @relation("ProgrammeAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lastEditor            User?               @relation("ProgrammeEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)
  courses               ProgrammeCourse[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, levelId])
  @@index([tenantId, departmentId])
  @@map("programmes")
}

model Course {
  id           String              @id @default(cuid())
  tenantId     String
  code         String?
  title        String
  slug         String
  summary      String?
  description  String?
  credits      Float?
  hours        Int?
  levelId      String?
  departmentId String?
  syllabus     String?
  status       PageStatus          @default(DRAFT)
  orderIndex   Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  level        AcademicLevel?      @relation(fields: [levelId], references: [id], onDelete: SetNull)
  department   AcademicDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  programmes   ProgrammeCourse[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, levelId])
  @@index([tenantId, departmentId])
  @@map("courses")
}

model ProgrammeCourse {
  programmeId String
  courseId    String
  isRequired  Boolean   @default(true)
  term        String?
  orderIndex  Int       @default(0)

  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([programmeId, courseId])
  @@index([programmeId])
  @@index([courseId])
  @@map("programme_courses")
}

model StaffProfile {
  id                String              @id @default(cuid())
  tenantId          String
  fullName          String
  slug              String
  roleTitle         String
  biography         String?
  departmentId      String?
  profileMediaId    String?
  subjects          String[]            @default([])
  qualifications    String?
  officeLocation    String?
  consultationHours String?
  publicEmail       String?
  publicPhone       String?
  displayEmail      Boolean             @default(false)
  displayPhone      Boolean             @default(false)
  websiteUrl        String?
  internalNotes     String?
  userId            String?
  status            PageStatus          @default(DRAFT)
  isActive          Boolean             @default(true)
  isFeatured        Boolean             @default(false)
  orderIndex        Int                 @default(0)
  publishedAt       DateTime?
  archivedAt        DateTime?
  seoTitle          String?
  seoDescription    String?
  canonicalUrl      String?
  authorId          String?
  lastEditorId      String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department        AcademicDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  profileMedia      MediaAsset?         @relation(fields: [profileMediaId], references: [id], onDelete: SetNull)
  user              User?               @relation("StaffUserAccount", fields: [userId], references: [id], onDelete: SetNull)
  author            User?               @relation("StaffAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lastEditor        User?               @relation("StaffEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId, status, isActive])
  @@index([tenantId, departmentId])
  @@index([tenantId, orderIndex])
  @@map("staff_profiles")
}

model NewsArticle {
  id              String      @id @default(cuid())
  tenantId        String
  title           String
  slug            String
  summary         String?
  body            String
  authorName      String?
  publishedAt     DateTime?
  archivedAt      DateTime?
  featuredMediaId String?
  tags            String[]    @default([])
  relatedIds      String[]    @default([])
  status          PageStatus  @default(DRAFT)
  seoTitle        String?
  seoDescription  String?
  canonicalUrl    String?
  authorId        String?
  lastEditorId    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featuredMedia   MediaAsset? @relation(fields: [featuredMediaId], references: [id], onDelete: SetNull)
  author          User?       @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lastEditor      User?       @relation("NewsEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, publishedAt])
  @@map("news_articles")
}

model Announcement {
  id           String               @id @default(cuid())
  tenantId     String
  title        String
  content      String
  priority     AnnouncementPriority @default(NORMAL)
  audience     AnnouncementAudience @default(GENERAL)
  isPinned     Boolean              @default(false)
  startsAt     DateTime?
  expiresAt    DateTime?
  status       PageStatus           @default(DRAFT)
  authorId     String?
  lastEditorId String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author       User?                @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lastEditor   User?                @relation("AnnouncementEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, startsAt, expiresAt])
  @@map("announcements")
}

model EventItem {
  id                 String      @id @default(cuid())
  tenantId           String
  title              String
  slug               String
  description        String?
  startsAt           DateTime
  endsAt             DateTime
  timezone           String      @default("UTC")
  location           String?
  category           String      @default("GENERAL")
  coverMediaId       String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  capacity           Int?
  isRegistrationOpen Boolean     @default(false)
  registrationUrl    String?
  status             PageStatus  @default(DRAFT)
  authorId           String?
  lastEditorId       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  tenant             Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coverMedia         MediaAsset? @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  author             User?       @relation("EventAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lastEditor         User?       @relation("EventEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([tenantId, startsAt])
  @@index([tenantId, endsAt])
  @@index([tenantId, category])
  @@map("events")
}


