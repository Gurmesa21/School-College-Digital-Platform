datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum InstitutionType {
  KINDERGARTEN
  PRIMARY_SECONDARY
  COLLEGE
  TVET_TRAINING_CENTRE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SectionType {
  HERO
  TEXT_CONTENT
  IMAGE_MEDIA
  FEATURE_GRID
}

enum NavigationLocation {
  HEADER
  FOOTER
  QUICK_LINKS
}

enum MediaCategory {
  IMAGE
  DOCUMENT
  VIDEO
  LOGO
  BANNER
}

enum CategoryType {
  MEDIA
  PAGE
  GENERAL
}

model Tenant {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  institutionType InstitutionType @default(PRIMARY_SECONDARY)
  status          TenantStatus    @default(ACTIVE)
  timezone        String          @default("UTC")
  defaultLocale   String          @default("en")
  contactEmail    String?
  contactPhone    String?
  address         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  domains         TenantDomain[]
  memberships     Membership[]
  roles           Role[]
  invitations     TenantInvitation[]
  auditLogs       AuditLog[]
  pages           Page[]
  navigationMenus NavigationMenu[]
  mediaAssets     MediaAsset[]
  categories      Category[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

model TenantDomain {
  id         String   @id @default(cuid())
  hostname   String   @unique
  isPrimary  Boolean  @default(false)
  isVerified Boolean  @default(true)
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([hostname])
  @@index([isVerified])
  @@map("tenant_domains")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  status                  UserStatus               @default(ACTIVE)
  firstName               String?
  lastName                String?
  emailVerifiedAt         DateTime?
  isSuperAdmin            Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  memberships             Membership[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  sentInvitations         TenantInvitation[]       @relation("SentInvitations")
  auditLogs               AuditLog[]               @relation("ActorAuditLogs")
  authoredPages           Page[]                   @relation("PageAuthor")
  editedPages             Page[]                   @relation("PageEditor")
  uploadedMedia           MediaAsset[]             @relation("UploadedMedia")

  @@index([email])
  @@index([status])
  @@map("users")
}

model Membership {
  id         String           @id @default(cuid())
  userId     String
  tenantId   String
  status     MembershipStatus @default(ACTIVE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles      MembershipRole[]

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@index([status])
  @@map("memberships")
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String?
  name        String
  displayName String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships MembershipRole[]

  @@index([tenantId])
  @@index([name])
  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  category    String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles       RolePermission[]

  @@index([code])
  @@index([category])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  membershipId String
  roleId       String
  assignedAt   DateTime   @default(now())

  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
  @@index([membershipId])
  @@index([roleId])
  @@map("membership_roles")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model TenantInvitation {
  id            String           @id @default(cuid())
  tenantId      String
  email         String
  inviterUserId String
  roleIds       String[]
  tokenHash     String           @unique
  status        InvitationStatus @default(PENDING)
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  sentAt        DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter       User             @relation("SentInvitations", fields: [inviterUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, email])
  @@index([tenantId, status])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("tenant_invitations")
}

model AuditLog {
  id         String       @id @default(cuid())
  tenantId   String?
  actorId    String?
  actorEmail String?
  actorType  String       @default("USER")
  action     String
  entityType String
  entityId   String?
  outcome    AuditOutcome @default(SUCCESS)
  requestId  String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime     @default(now())

  tenant     Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor      User?        @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Page {
  id                 String        @id @default(cuid())
  tenantId           String
  title              String
  slug               String
  summary            String?
  status             PageStatus    @default(DRAFT)
  authorId           String?
  lastEditorId       String?
  publishedAt        DateTime?
  scheduledPublishAt DateTime?
  archivedAt         DateTime?
  expiresAt          DateTime?
  seoTitle           String?
  seoDescription     String?
  canonicalUrl       String?
  version            Int           @default(1)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author             User?         @relation("PageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  lastEditor         User?         @relation("PageEditor", fields: [lastEditorId], references: [id], onDelete: SetNull)
  sections           PageSection[]
  navigationItems    NavigationMenuItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([status, publishedAt])
  @@index([scheduledPublishAt])
  @@map("pages")
}

model PageSection {
  id          String      @id @default(cuid())
  pageId      String
  sectionType SectionType
  sortOrder   Int         @default(0)
  isVisible   Boolean     @default(true)
  config      Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  page        Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@map("page_sections")
}

model NavigationMenu {
  id          String              @id @default(cuid())
  tenantId    String
  location    NavigationLocation  @default(HEADER)
  title       String
  isPublished Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items       NavigationMenuItem[]

  @@unique([tenantId, location])
  @@index([tenantId])
  @@map("navigation_menus")
}

model NavigationMenuItem {
  id          String              @id @default(cuid())
  menuId      String
  parentId    String?
  label       String
  url         String
  target      String              @default("_self")
  order       Int                 @default(0)
  isVisible   Boolean             @default(true)
  pageId      String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  menu        NavigationMenu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent      NavigationMenuItem? @relation("MenuItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    NavigationMenuItem[] @relation("MenuItemHierarchy")
  page        Page?               @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([menuId, order])
  @@index([parentId])
  @@index([pageId])
  @@map("navigation_menu_items")
}

model Category {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  type        CategoryType  @default(GENERAL)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mediaAssets MediaAsset[]

  @@unique([tenantId, slug])
  @@index([tenantId, type])
  @@map("categories")
}

model MediaAsset {
  id            String        @id @default(cuid())
  tenantId      String
  uploaderId    String?
  title         String
  altText       String?
  caption       String?
  category      MediaCategory @default(IMAGE)
  mimeType      String
  fileSizeBytes Int
  storageKey    String
  publicUrl     String
  isPublic      Boolean       @default(true)
  isDecorative  Boolean       @default(false)
  categoryId    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploader      User?         @relation("UploadedMedia", fields: [uploaderId], references: [id], onDelete: SetNull)
  taxCategory   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([tenantId, category])
  @@index([tenantId, isPublic])
  @@index([uploaderId])
  @@map("media_assets")
}
