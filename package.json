{
  "name": "school-platform-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev --workspace=@school/api\" \"npm run dev --workspace=@school/web\"",
    "dev:api": "npm run dev --workspace=@school/api",
    "dev:web": "npm run dev --workspace=@school/web",
    "build": "npm run build --workspace=@school/shared && npm run build --workspace=@school/db && npm run build --workspace=@school/api && npm run build --workspace=@school/web",
    "build:shared": "npm run build --workspace=@school/shared",
    "build:db": "npm run build --workspace=@school/db",
    "build:api": "npm run build --workspace=@school/api",
    "build:web": "npm run build --workspace=@school/web",
    "pretypecheck": "npm run build:shared && npm run build:db",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "pretest": "npm run build:shared && npm run build:db",
    "test": "npm run test --workspaces --if-present",
    "prisma:validate": "npm run prisma:validate --workspace=@school/db",
    "prisma:generate": "npm run prisma:generate --workspace=@school/db",
    "prisma:migrate": "npm run prisma:migrate --workspace=@school/db",
    "db:seed": "npm run db:seed --workspace=@school/db",
    "test:smoke": "node scripts/smokeTest.mjs",
    "test:e2e": "playwright test",
    "benchmark:web": "node scripts/benchmarkWeb.mjs",
    "benchmark:api": "node scripts/benchmarkApi.mjs",
    "test:perf": "node scripts/benchmarkWeb.mjs && node scripts/benchmarkApi.mjs",
    "db:backup": "node scripts/backupDatabase.mjs",
    "db:restore": "node scripts/restoreDatabase.mjs --confirm-drop-target",
    "db:verify-restore": "node scripts/verifyRestoreParity.mjs",
    "db:drill": "node scripts/backupDatabase.mjs && node scripts/restoreDatabase.mjs --confirm-drop-target && node scripts/verifyRestoreParity.mjs"
  },
  "prisma": {
    "schema": "packages/db/prisma/schema.prisma",
    "seed": "npm run db:seed --workspace=@school/db"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.8.2"
  }
}