# =============================================================================
# Private School & College Digital Website Platform — Environment Variables
# =============================================================================
# NOTE: This is a sanitized template. Copy to .env.local for local overrides.
# Never commit real credentials, passwords, or production secrets to Git.

# Node & Application Environment
NODE_ENV=development
APP_ENV=development

# Multi-Tenant Resolution & Security Settings
# Local query override (?tenant=<slug>) is permitted ONLY in development on localhost
ALLOW_DEV_TENANT_OVERRIDE=true
# Set to true only if running behind a trusted reverse proxy (e.g. Nginx, Cloudflare)
TRUST_PROXY=false

# REST API Service (apps/api)
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Public Website & Admin Frontend (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# PostgreSQL Database Connection (packages/db)
# Form: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Example local placeholder (DO NOT USE REAL SECRETS IN THIS TEMPLATE):
DATABASE_URL="postgresql://postgres:postgres_password_placeholder@localhost:5432/school_platform_dev?schema=public"

# Future Security & Session Placeholders (Release 1 Milestone 2)
# JWT_SECRET=your_dev_jwt_secret_placeholder_at_least_32_characters
# SESSION_SECRET=your_dev_session_secret_placeholder_at_least_32_characters
