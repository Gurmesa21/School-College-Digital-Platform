# =============================================================================
# Docker Development Database Environment Configuration
# =============================================================================
# Use these settings when connecting the application to the isolated Docker container.
# Dedicated container port: 55432 (mapped to internal PostgreSQL port 5432)

POSTGRES_USER=dev_user
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=gurmesa_dev_db
POSTGRES_PORT=55432

# Application DATABASE_URL connection string for Docker PostgreSQL instance
DATABASE_URL="postgresql://dev_user:dev_password@localhost:55432/gurmesa_dev_db?schema=public"
